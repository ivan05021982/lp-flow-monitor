{
  "_note": "Keyless public RPC nodes. max_span = largest eth_getLogs block range each one accepted when measured; batch = eth_getLogs calls per HTTP request; header_batch = block headers per HTTP request. First provider of a chain is the working source, the second is the independent cross-check and the fallback. Arbitrum's official node returns blockTimestamp 0x0 on logs, so its timestamps are read from block headers: correct but slow, hence second. pools_file and cache_dir are relative to this file's folder.",
  "measured": "2026-10-05",
  "pools_file": "../pools.json",
  "cache_dir": "_cache",
  "chains": {
    "ethereum": {
