        {"name": "mevblocker", "url": "https://rpc.mevblocker.io", "max_span": 10000, "batch": 1}
      ]
    },
    "arbitrum": {
      "providers": [
        {"name": "tenderly", "url": "https://arbitrum.gateway.tenderly.co", "max_span": 100000, "batch": 1},
        {"name": "arbitrum-official", "url": "https://arb1.arbitrum.io/rpc", "max_span": 50000, "batch": 1, "header_batch": 100}
      ]
    },
    "base": {
      "providers": [
        {"name": "base-official", "url": "https://mainnet.base.org", "max_span": 500, "batch": 10},
        {"name": "tenderly", "url": "https://base.gateway.tenderly.co", "max_span": 1000, "batch": 1}
      ]
    },
    "optimism": {
      "providers": [
        {"name": "optimism-official", "url": "https://mainnet.optimism.io", "max_span": 500000, "batch": 1},
        {"name": "tenderly", "url": "https://optimism.gateway.tenderly.co", "max_span": 100000, "batch": 1}
      ]
    }
  }
